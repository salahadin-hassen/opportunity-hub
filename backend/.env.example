# Database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/opportunity_hub

# Dedicated database for pytest. Create it separately before running tests.
# The database name must include "test" and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/opportunity_hub_test

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Authentication
# Symmetric secret used to sign local JWT identity tokens.
# Generate one per environment, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256

# Curator access
# Roles are stored on users.role and changed only with: python -m app.cli grant-role <email> <role>
# (student, curator or admin). There is no shared admin token any more.

# Production
# APP_ENV=production refuses a JWT_SECRET shorter than 32 characters or equal to the placeholder above.
# Browser origins allowed to call the API cross-origin (comma-separated, no "*"). Empty disables CORS.
# CORS_ORIGINS=https://opportunity-hub.onrender.com
# Host headers to accept (comma-separated). Empty accepts any host.
# ALLOWED_HOSTS=opportunity-hub-api.onrender.com
# Login and registration attempts allowed per minute, per client address and per account. Unset disables it.
# AUTH_RATE_LIMIT_PER_MINUTE=10
# Where the client address comes from (see app/core/config.py). Keep "peer" until the proxy is verified.
# CLIENT_IP_STRATEGY=peer
# Concurrent Argon2 operations per process (64 MiB each), and how many of them registration may use.
# ARGON2_MAX_CONCURRENCY=2
# ARGON2_REGISTRATION_MAX_CONCURRENCY=1
