# Copy to .env.development.local (git-ignored) to enable "Use demo account" on the sign-in page.
# Vite reads it for `npm run dev` only; production builds never contain these values.
# They must match the account created by backend/scripts/seed_demo.py.
VITE_DEMO_EMAIL=demo@example.org
VITE_DEMO_PASSWORD=ohub-demo-2026
